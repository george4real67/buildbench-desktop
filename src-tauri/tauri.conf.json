{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BuildBench",
  "version": "0.1.1",
  "identifier": "com.kagam.tauri-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "BuildBench",
        "url": "index.html",
        "zoomHotkeysEnabled": true,
        "devtools": false,
        "width": 1280,
        "height": 800,
        "create": false
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "BuildBench",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/george4real67/buildbench-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0M0Q0RDMzRkEwNTI2Q0YKUldUUEpnWDZNMDA5TkFLZjJQMHh5SDFLUHdVUXFoWHRVa29aWUxEQ0RxTEswV3d1Q2o1T2FBN1EK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
